DEBUG=false
# Prefer DJANGO_SECRET_KEY in production; SECRET_KEY still works locally.
DJANGO_SECRET_KEY=change-me-in-production
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
# Exact frontend origin(s) only — no wildcards.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAPBOX_TOKEN=pk.your_mapbox_token_here
GEOCODE_COUNTRY=us
REDIS_URL=
# Alias: THROTTLE_RATE (deploy) or ANON_RATE_THROTTLE (local)
THROTTLE_RATE=60/min
ANON_RATE_THROTTLE=60/min
APP_VERSION=0.1.0
# Set true behind HTTPS terminators (Render). Keep false for plain HTTP Docker.
SECURE_SSL_REDIRECT=false
