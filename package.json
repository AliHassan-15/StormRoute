{
  "name": "stormroute",
  "private": true,
  "version": "0.1.0",
  "description": "StormRoute — weather-aware truck routing",
  "scripts": {
    "dev": "npm run dev:backend & npm run dev:frontend",
    "dev:backend": "cd backend && ..\\.venv\\Scripts\\python.exe manage.py runserver 8000",
    "dev:frontend": "npm --prefix frontend run dev",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd backend && ..\\.venv\\Scripts\\python.exe -m pytest",
    "test:frontend": "npm --prefix frontend run test",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "lint:backend": "cd backend && ..\\.venv\\Scripts\\ruff.exe check .",
    "lint:frontend": "npm --prefix frontend run lint",
    "typecheck": "npm --prefix frontend run typecheck",
    "build": "npm --prefix frontend run build"
  }
}
